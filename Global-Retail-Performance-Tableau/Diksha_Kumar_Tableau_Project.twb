      <aliases enabled='yes' />
      <column caption='Category Preformance' datatype='string' name='[Calculation_1776586796568576]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit])&gt;0 THEN &quot;Profitable&quot; &#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='Discount Level' datatype='string' name='[Calculation_1776586810421249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Discount]) = 0 THEN &quot;No Discount&quot; &#13;&#10;ELSEIF ([Discount]) &lt;= 0.2 THEN &quot;Low Discount&quot;&#13;&#10;ELSEIF ([Discount]) &lt;= 0.5 THEN &quot;Medium Discount&quot; &#13;&#10;ELSE &quot;High Discount&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1776586819792898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Profit Category' datatype='string' name='[Calculation_1776586819997699]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSEIF [Profit] &lt; 500 THEN &quot;Low Profit&quot;&#13;&#10;ELSE &quot;High Profit&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_1776586831065092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] / [Quantity]' />
      </column>
